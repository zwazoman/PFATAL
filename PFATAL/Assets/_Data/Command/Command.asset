  m_Script: {fileID: 11500000, guid: a1f9be98e62202445b534d926bc1c55d, type: 3}
  m_Name: Command
  m_EditorClassIdentifier: Assembly-CSharp::Command
  CommandData:
  - Name: 
    Command: 'SELECT

      Game.Id AS GameId,

      Player.Name

      FROM
      GamePlayerSet

      JOIN Player ON Player.Id = GamePlayerSet.IdPlayer

      JOIN
      Game ON Game.Id = GamePlayerSet.IdGame'
