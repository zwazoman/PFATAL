%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1f9be98e62202445b534d926bc1c55d, type: 3}
  m_Name: Command
  m_EditorClassIdentifier: Assembly-CSharp::Command
  CommandData:
  - Name: "R\xE9cup\xE8re quel joueur  a jou\xE9 a quel partie"
    Command: 'SELECT

      Game.Id AS GameId,

      Player.Name

      FROM GamePlayerSet

      JOIN
      Player ON Player.Id = GamePlayerSet.IdPlayer

      JOIN Game ON Game.Id =
      GamePlayerSet.IdGame'
  - Name: "R\xE9cup\xE8re les armes et le nombre de fois ou elles ont \xE9t\xE9 utilis\xE9
      rang\xE9 par ordre croissant"
    Command: 'SELECT

      Weapon,

      COUNT(*) AS UsageCount

      FROM
      Death

      GROUP BY Weapon

      ORDER BY UsageCount DESC'
  - Name: Distance moyenne des kills
    Command: 'SELECT

      AVG(Distance) AS AverageKillDistance

      FROM Death'
